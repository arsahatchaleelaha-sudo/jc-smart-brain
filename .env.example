# เหล่านี้ต้องตั้งใน .env จริง — ห้าม commit key จริง
# คัดลอกไฟล์นี้ไปเป็น .env แล้วเติมค่า

# ─── LLM ────────────────────────────────────────────────────────────────────────
# Brain ใช้ Anthropic โดยตรง (Haiku สำหรับ classify/compliance, Sonnet สำหรับ reason)
# ชื่อ env ต้องตรงกับ 꼭ที่ Anthropic issue ออกมา
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── EMBEDDING ──────────────────────────────────────────────────────────────────
# ใช้ OpenAI embeddings (text-embedding-3-small) สำหรับ semantic cache + RAG
# มีให้ใช้ฟรี 500K tokens/เดือน เริ่มจากโมเดลนี้ก็พอ
OPENAI_API_KEY=sk-proj-...

# ─── VECTOR STORE ──────────────────────────────────────────────────────────────
# เริ่มด้วย PG_VECTOR_PATH = path ไปยัง db ท้องถิ่น (sqlite ไกว่าง่ายสุด)
# Phase 3 ขึ้นไปค่อยเปลี่ยนเป็น Qdrant/PG ร่วม
PG_VECTOR_PATH=./data/brain_vector.db

# ─── CACHE ─────────────────────────────────────────────────────────────────────
# semantic cache + FAQ cache เก็บที่นี่ (json ไฟล์ เริ่มใช้ไฟล์เดียวก่อน)
CACHE_PATH=./data/brain_cache.json

# ─── SERVER ────────────────────────────────────────────────────────────────────
# โหมด: dev / beta / prod
BRAIN_ENV=dev
BRAIN_PORT=8000
